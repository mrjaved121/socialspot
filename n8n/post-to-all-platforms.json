{
  "name": "SocialSpot - Post or schedule a video on all platforms",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Post to all platforms",
        "formDescription": "One portrait video + caption goes to TikTok, Instagram, Facebook and YouTube. Post now, pick a date and time, or put it in the next free queue slot.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Video",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".mp4,.mov",
              "requiredField": true
            },
            {
              "fieldLabel": "Caption",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "YouTube title",
              "placeholder": "Optional - max 100 letters"
            },
            {
              "fieldLabel": "When",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Post now"
                  },
                  {
                    "option": "Schedule"
                  },
                  {
                    "option": "Next free queue slot"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Date",
              "fieldType": "date"
            },
            {
              "fieldLabel": "Time",
              "placeholder": "24-hour, e.g. 19:00 (only for Schedule)"
            }
          ]
        },
        "options": {}
      },
